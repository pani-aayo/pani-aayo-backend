PORT=3000
NODE_ENV=development

POSTGRES_USER=pani
POSTGRES_PASSWORD=pani
POSTGRES_DB=pani_aayo
POSTGRES_PORT=5432

# App runtime (use host `db` inside Docker Compose)
DATABASE_URL=postgresql://pani:pani@localhost:5432/pani_aayo?schema=public

# Optional: Prisma CLI against localhost while the app uses Docker networking
PRISMA_DATABASE_URL=postgresql://pani:pani@localhost:5432/pani_aayo?schema=public

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
