PORT=3000
NODE_ENV=development

POSTGRES_USER=pani
POSTGRES_PASSWORD=pani
POSTGRES_DB=pani_aayo
POSTGRES_PORT=5432

# App runtime (use host `db` inside Docker Compose)
DATABASE_URL=postgresql://pani:pani@localhost:5432/pani_aayo?schema=public

# Optional: Prisma CLI against localhost while the app uses Docker networking
PRISMA_DATABASE_URL=postgresql://pani:pani@localhost:5432/pani_aayo?schema=public

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Firebase Admin SDK (for push notifications) — see Firebase Console > Project Settings > Service Accounts
# Optional: leave unset to run with push notifications disabled.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# APNs auth key (for iOS VoIP "ringing alert" pushes) — Apple Developer > Certificates, Identifiers & Profiles > Keys.
# Optional: leave unset to run with ringing alerts disabled on iOS (Android ringing still works).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox
