model User {
  id        Int      @id @default(autoincrement())
  code      String   @unique @map("code")
  name      String   @map("name")
  email     String   @unique @map("email")
  password  String   @map("password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles             UserRoles[]
  pipelinesCreated      Pipeline[]              @relation("PipelineCreatedBy")
  pipelinesUpdated      Pipeline[]              @relation("PipelineUpdatedBy")
  pipelinesDeleted      Pipeline[]              @relation("PipelineDeletedBy")
  pipelinesOperators    PipelineOperators[]
  devices               UserDevices[]
  pipelineSubscriptions PipelineSubscriptions[]

  @@map("users")
}

model UserDevices {
  id        Int      @id @default(autoincrement()) @map("id")
  userCode  String   @map("user_code")
  deviceId  String   @unique @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userCode], references: [code])

  @@index([userCode])
  @@map("user_devices")
}

model UserRoles {
  id        Int      @id @default(autoincrement()) @map("id")
  userCode  String   @map("user_code")
  role      UserRole @map("role")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userCode], references: [code])

  @@map("user_roles")
}

enum UserRole {
  ADMIN
  OPERATOR
  RESIDENT
}
